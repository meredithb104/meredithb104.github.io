{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "oxc",
    "unicorn"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "src/styles/tokens.css"
  ],
  "rules": {
    "unicorn/consistent-function-scoping": "off"
  }
}
