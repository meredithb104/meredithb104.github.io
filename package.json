{
  "name": "meredithb104.github.io",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Meredith Boyce, front-end engineer. Portfolio site: static HTML, hand-written CSS, TypeScript web components, no framework runtime. WCAG 2.2 AA, contrast enforced at build time.",
  "author": "Meredith Boyce",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/meredithb104/meredithb104.github.io.git"
  },
  "homepage": "https://meredithb104.github.io/",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.ts",
    "posts": "node scripts/build-posts.ts",
    "prepare-content": "npm run tokens && npm run posts",
    "dev": "npm run prepare-content && vite",
    "build": "npm run prepare-content && tsc -b && vite build",
    "preview": "vite preview --port 4180 --strictPort",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "npm run prepare-content && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "og-card": "node scripts/og-card/render.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.13.5",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.0",
    "marked": "^18.0.13",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "commons-ui": "github:meredithb104/commons-ui#9103b3e"
  }
}
