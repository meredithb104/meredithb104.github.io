{
  "$description": "Design tokens for meredithb104.github.io. Source of truth. `npm run tokens` compiles this to src/styles/tokens.css. Every color that declares $contrastAgainst is checked with the WCAG 2.x formula by scripts/build-tokens.ts; the build fails if any pair drops below its $minRatio.",

  "font": {
    "family": {
      "sans": { "value": "'Public Sans', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif", "$note": "Public Sans is self-hosted and preloaded; the system stack is the fallback and an option in the Lab." },
      "mono": { "value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" }
    },
    "size": {
      "sm": { "value": "0.875rem" },
      "md": { "value": "1rem" },
      "lg": { "value": "1.125rem" },
      "xl": { "value": "1.375rem" },
      "2xl": { "value": "clamp(1.5rem, 1.2rem + 1.2vw, 1.875rem)" },
      "3xl": { "value": "clamp(1.875rem, 1.3rem + 2.4vw, 2.75rem)" }
    },
    "lineHeight": {
      "tight": { "value": "1.2" },
      "body": { "value": "1.6" }
    },
    "weight": {
      "regular": { "value": "400" },
      "medium": { "value": "500" },
      "bold": { "value": "700" }
    }
  },

  "space": {
    "1": { "value": "0.25rem" },
    "2": { "value": "0.5rem" },
    "3": { "value": "0.75rem" },
    "4": { "value": "1rem" },
    "5": { "value": "1.5rem" },
    "6": { "value": "2rem" },
    "7": { "value": "3rem" },
    "8": { "value": "4.5rem" }
  },

  "radius": {
    "sm": { "value": "4px" },
    "md": { "value": "8px" },
    "lg": { "value": "14px" },
    "pill": { "value": "999px" }
  },

  "size": {
    "target": { "value": "44px", "$note": "WCAG 2.5.8 Target Size (Minimum) is 24px; 44px meets 2.5.5 (Enhanced)." },
    "focusRing": { "value": "3px" },
    "focusOffset": { "value": "2px" },
    "border": { "value": "1px" },
    "borderStrong": { "value": "2px" },
    "measure": { "value": "68ch", "$note": "WCAG 1.4.8 line length: no more than 80 characters." },
    "content": { "value": "72rem" }
  },

  "motion": {
    "duration": {
      "fast": { "value": "120ms" },
      "base": { "value": "200ms" }
    },
    "easing": {
      "standard": { "value": "cubic-bezier(0.2, 0, 0, 1)" }
    }
  },

  "theme": {
    "light": {
      "color": {
        "bg": {"value": "#F4F1E8", "$note": "Cake batter as a page: the swatch #DCD6C2 lightened so text can sit on it at 7:1 and borders at 3:1."},
        "bgSubtle": {"value": "#E6E1CF", "$note": "Cake batter nearer the swatch: header, code, subtle panels."},
        "surface": {"value": "#FFFFFF", "$note": "Palette: white."},
        "text": {"value": "#14224A", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 7, "$note": "Palette: royal navy, as given."},
        "textMuted": {"value": "#4A5470", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 4.5, "$note": "A gray with the navy in it."},
        "border": {"value": "#767C8E", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 3},
        "borderSubtle": {"value": "#CFD3DE"},
        "primary": {"value": "#3550B0", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 4.5, "$note": "Palette: yearbook, as given. Links and buttons."},
        "onPrimary": {"value": "#FFFFFF", "$contrastAgainst": ["primary"], "$minRatio": 4.5},
        "primaryHover": {"value": "#14224A", "$contrastAgainst": ["bg", "surface"], "$minRatio": 4.5, "$note": "Royal navy."},
        "accent": {"value": "#3550B0", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 4.5, "$note": "Palette: yearbook, as given. Eyebrow text; set in caps and letter-spaced, so it is not mistaken for a link."},
        "accentBg": {"value": "#A9C1E8", "$note": "Palette: monaco blue, as given, as the box for callouts and diagram stores. Text on it uses onAccentBg."},
        "onAccentBg": {"value": "#14224A", "$contrastAgainst": ["accentBg"], "$minRatio": 7},
        "onAccentBgMuted": {"value": "#2E3A5E", "$contrastAgainst": ["accentBg"], "$minRatio": 4.5},
        "success": {"value": "#1E3A78", "$contrastAgainst": ["bg", "surface", "successBg"], "$minRatio": 4.5, "$note": "No green in the palette: Pass is a blue between yearbook and navy, and carries an icon and the word."},
        "successBg": {"value": "#DFE8F7", "$note": "Monaco blue tint."},
        "error": {"value": "#B42318", "$contrastAgainst": ["bg", "surface", "errorBg"], "$minRatio": 4.5, "$note": "A plain red for errors only, outside the palette on purpose: an error colour is functional, and errors also carry an icon and the word."},
        "errorBg": {"value": "#FBEAE8"},
        "focus": {"value": "#14224A", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 3, "$note": "Royal navy as the ring, 15:1 on the page, 2px outside every control; buttons are the lighter yearbook blue, so a ring is never lost against the thing it rings."},
        "codeBg": {"value": "#E6E1CF"},
        "codeText": {"value": "#14224A", "$contrastAgainst": ["codeBg"], "$minRatio": 7},
        "brand1": {"value": "#14224A", "$note": "The monogram tile: royal navy on light."},
        "onBrand1": {"value": "#FFFFFF", "$contrastAgainst": ["brand1"], "$minRatio": 4.5, "$note": "The monogram letters."},
        "brand2": {"value": "#14224A", "$note": "The header rule and card rules."},
        "brand3": {"value": "#DCD6C2", "$note": "Palette: cake batter."},
        "brand4": {"value": "#A9C1E8", "$note": "Palette: monaco blue. Side rules."},
        "brand5": {"value": "#3550B0", "$note": "Palette: yearbook."},
        "brand6": {"value": "#14224A", "$note": "Palette: royal navy."}
      }
    },
    "dark": {
      "color": {
        "bg": {"value": "#14224A", "$note": "Palette: royal navy, as given."},
        "bgSubtle": {"value": "#182957"},
        "surface": {"value": "#1D3160"},
        "text": {"value": "#F4F1E8", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 7, "$note": "Cake batter lightened: warm white."},
        "textMuted": {"value": "#C3D2EC", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 4.5, "$note": "Monaco blue, a touch lighter."},
        "border": {"value": "#8390B4", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 3},
        "borderSubtle": {"value": "#34467A"},
        "primary": {"value": "#A9C1E8", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 4.5, "$note": "Palette: monaco blue, as given. Links and buttons."},
        "onPrimary": {"value": "#14224A", "$contrastAgainst": ["primary"], "$minRatio": 4.5},
        "primaryHover": {"value": "#FFFFFF", "$contrastAgainst": ["bg", "surface"], "$minRatio": 4.5},
        "accent": {"value": "#DCD6C2", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 4.5, "$note": "Palette: cake batter, as given, for eyebrow text: the burgundy is 1.5:1 on the navy. Never text on accentBg."},
        "accentBg": {"value": "#A9C1E8", "$note": "Monaco blue as the box, the same box as light."},
        "onAccentBg": {"value": "#14224A", "$contrastAgainst": ["accentBg"], "$minRatio": 7},
        "onAccentBgMuted": {"value": "#2E3A5E", "$contrastAgainst": ["accentBg"], "$minRatio": 4.5},
        "success": {"value": "#DCD6C2", "$contrastAgainst": ["bg", "surface", "successBg"], "$minRatio": 4.5, "$note": "Cake batter: the Pass pill's text and border; Fail is the rose. Both carry an icon and the word."},
        "successBg": {"value": "#26386B"},
        "error": {"value": "#F2A7A3", "$contrastAgainst": ["bg", "surface", "errorBg"], "$minRatio": 4.5, "$note": "A plain red lifted for text on the navy; errors only. Also the Fail pill and invalid-field border."},
        "errorBg": {"value": "#4A2020"},
        "focus": {"value": "#FFFFFF", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 3, "$note": "A white ring on the navy: 15:1, and never a button color."},
        "codeBg": {"value": "#233A70"},
        "codeText": {"value": "#F4F1E8", "$contrastAgainst": ["codeBg"], "$minRatio": 7},
        "brand1": {"value": "#A9C1E8", "$note": "The monogram tile: monaco blue on the navy."},
        "onBrand1": {"value": "#14224A", "$contrastAgainst": ["brand1"], "$minRatio": 4.5, "$note": "The monogram letters."},
        "brand2": {"value": "#A9C1E8", "$note": "The header rule and card rules."},
        "brand3": {"value": "#DCD6C2"},
        "brand4": {"value": "#A9C1E8"},
        "brand5": {"value": "#3550B0"},
        "brand6": {"value": "#14224A"}
      }
    },
    "highContrast": {
      "$description": "Black on white, one accent, thicker borders. Windows forced-colors users get system colors instead, via CSS in base.css.",
      "color": {
        "bg":            { "value": "#FFFFFF" },
        "bgSubtle":      { "value": "#FFFFFF" },
        "surface":       { "value": "#FFFFFF" },
        "text":          { "value": "#000000", "$contrastAgainst": ["bg", "surface"], "$minRatio": 7 },
        "textMuted":     { "value": "#000000", "$contrastAgainst": ["bg", "surface"], "$minRatio": 7 },
        "border":        { "value": "#000000", "$contrastAgainst": ["bg", "surface"], "$minRatio": 3 },
        "borderSubtle":  { "value": "#000000" },
        "primary":       { "value": "#0000CC", "$contrastAgainst": ["bg", "surface"], "$minRatio": 7 },
        "onPrimary":     { "value": "#FFFFFF", "$contrastAgainst": ["primary"], "$minRatio": 7 },
        "primaryHover":  { "value": "#000080", "$contrastAgainst": ["bg", "surface"], "$minRatio": 7 },
        "accent":        { "value": "#000000", "$contrastAgainst": ["bg", "surface", "accentBg"], "$minRatio": 7 },
        "accentBg":      { "value": "#FFFFFF" },
        "onAccentBg":    { "value": "#000000", "$contrastAgainst": ["accentBg"], "$minRatio": 7 },
        "onAccentBgMuted": { "value": "#000000", "$contrastAgainst": ["accentBg"], "$minRatio": 7 },
        "success":       { "value": "#005A00", "$contrastAgainst": ["bg", "surface", "successBg"], "$minRatio": 7 },
        "successBg":     { "value": "#FFFFFF" },
        "error":         { "value": "#B00000", "$contrastAgainst": ["bg", "surface", "errorBg"], "$minRatio": 7 },
        "errorBg":       { "value": "#FFFFFF" },
        "focus":         { "value": "#000000", "$contrastAgainst": ["bg", "surface"], "$minRatio": 3 },
        "codeBg":        { "value": "#FFFFFF" },
        "codeText":      { "value": "#000000", "$contrastAgainst": ["codeBg"], "$minRatio": 7 },
        "brand1":        { "value": "#000000" },
        "onBrand1":      { "value": "#FFFFFF", "$contrastAgainst": ["brand1"], "$minRatio": 4.5 },
        "brand2":        { "value": "#000000" },
        "brand3":        { "value": "#000000" },
        "brand4":        { "value": "#000000" },
        "brand5":        { "value": "#000000" },
        "brand6":        { "value": "#000000" }
      }
    }
  }
}
