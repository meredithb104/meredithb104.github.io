{
  "$description": "Design tokens for meredithb104.github.io. Source of truth. `npm run tokens` compiles this to src/styles/tokens.css. Every color that declares $contrastAgainst is checked with the WCAG 2.x formula by scripts/build-tokens.ts; the build fails if any pair drops below its $minRatio.",

  "font": {
    "family": {
      "sans": { "value": "'Public Sans', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif", "$note": "Public Sans is self-hosted and preloaded; the system stack is the fallback and an option in the Lab." },
      "mono": { "value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" }
    },
    "size": {
      "sm": { "value": "0.875rem" },
      "md": { "value": "1rem" },
      "lg": { "value": "1.125rem" },
      "xl": { "value": "1.375rem" },
      "2xl": { "value": "clamp(1.5rem, 1.2rem + 1.2vw, 1.875rem)" },
      "3xl": { "value": "clamp(1.875rem, 1.3rem + 2.4vw, 2.75rem)" }
    },
    "lineHeight": {
      "tight": { "value": "1.2" },
      "body": { "value": "1.6" }
    },
    "weight": {
      "regular": { "value": "400" },
      "medium": { "value": "500" },
      "bold": { "value": "700" }
    }
  },

  "space": {
    "1": { "value": "0.25rem" },
    "2": { "value": "0.5rem" },
    "3": { "value": "0.75rem" },
    "4": { "value": "1rem" },
    "5": { "value": "1.5rem" },
    "6": { "value": "2rem" },
    "7": { "value": "3rem" },
    "8": { "value": "4.5rem" }
  },

  "radius": {
    "sm": { "value": "4px" },
    "md": { "value": "8px" },
    "lg": { "value": "14px" },
    "pill": { "value": "999px" }
  },

  "size": {
    "target": { "value": "44px", "$note": "WCAG 2.5.8 Target Size (Minimum) is 24px; 44px meets 2.5.5 (Enhanced)." },
    "focusRing": { "value": "3px" },
    "focusOffset": { "value": "2px" },
    "border": { "value": "1px" },
    "borderStrong": { "value": "2px" },
    "measure": { "value": "68ch", "$note": "WCAG 1.4.8 line length: no more than 80 characters." },
    "content": { "value": "72rem" }
  },

  "motion": {
    "duration": {
      "fast": { "value": "120ms" },
      "base": { "value": "200ms" }
    },
    "easing": {
      "standard": { "value": "cubic-bezier(0.2, 0, 0, 1)" }
    }
  },

  "theme": {
    "light": {
      "color": {
        "bg": {"value": "#F9FBF2"},
        "bgSubtle": {"value": "#EAF6F8"},
        "surface": {"value": "#FFFFFF"},
        "text": {"value": "#0E1C36", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 7, "$note": "Prussian blue, the palette's ink."},
        "textMuted": {"value": "#44506A", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 4.5},
        "border": {"value": "#7E8AA3", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 3},
        "borderSubtle": {"value": "#C9D9EC"},
        "primary": {"value": "#1B3F7A", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 4.5},
        "onPrimary": {"value": "#FFFFFF", "$contrastAgainst": ["primary"], "$minRatio": 4.5},
        "primaryHover": {"value": "#0E1C36", "$contrastAgainst": ["bg", "surface"], "$minRatio": 4.5},
        "accent": {"value": "#C81E37", "$contrastAgainst": ["bg", "surface", "bgSubtle", "accentBg"], "$minRatio": 4.5, "$note": "The pink, deepened until it can be text. #F45866 itself is 3.1:1 on ivory."},
        "accentBg": {"value": "#FFE3D1", "$note": "Peach surface for callouts and diagram stores. Text on it uses onAccentBg, never the page text color."},
        "onAccentBg": {"value": "#0E1C36", "$contrastAgainst": ["accentBg"], "$minRatio": 7},
        "onAccentBgMuted": {"value": "#44506A", "$contrastAgainst": ["accentBg"], "$minRatio": 4.5},
        "success": {"value": "#1E6B3A", "$contrastAgainst": ["bg", "surface", "successBg"], "$minRatio": 4.5},
        "successBg": {"value": "#E3F1E6"},
        "error": {"value": "#8B1A3C", "$contrastAgainst": ["bg", "surface", "errorBg"], "$minRatio": 4.5, "$note": "Berry, cooler than the pink accent; errors also carry an icon and the word."},
        "errorBg": {"value": "#FBE3EA"},
        "focus": {"value": "#EE4756", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 3, "$note": "The pink as a ring: 3.4:1 on the page, 2px outside every control."},
        "codeBg": {"value": "#EAF6F8"},
        "codeText": {"value": "#0E1C36", "$contrastAgainst": ["codeBg"], "$minRatio": 7},
        "brand1": {"value": "#FFEDE1", "$note": "Palette: powder petal. Surface only."},
        "brand2": {"value": "#F9FBF2", "$note": "Palette: ivory. Surface only."},
        "brand3": {"value": "#D7F9FF", "$note": "Palette: light cyan. Surface only."},
        "brand4": {"value": "#AFCBFF", "$note": "Palette: baby blue ice. Surface only."},
        "brand5": {"value": "#0E1C36", "$note": "Palette: Prussian blue."},
        "brand6": {"value": "#F45866", "$note": "The pink accent. Decorative here; as text it is #C81E37 (light) or itself on dark."}
      }
    },
    "dark": {
      "color": {
        "bg": {"value": "#0E1C36"},
        "bgSubtle": {"value": "#13244A"},
        "surface": {"value": "#182B55"},
        "text": {"value": "#F9FBF2", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 7},
        "textMuted": {"value": "#C5D2EC", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 4.5},
        "border": {"value": "#7E93BD", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 3},
        "borderSubtle": {"value": "#2E4270"},
        "primary": {"value": "#AFCBFF", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 4.5, "$note": "Palette: baby blue ice."},
        "onPrimary": {"value": "#0E1C36", "$contrastAgainst": ["primary"], "$minRatio": 4.5},
        "primaryHover": {"value": "#D7F9FF", "$contrastAgainst": ["bg", "surface"], "$minRatio": 4.5},
        "accent": {"value": "#FF8A94", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 4.5, "$note": "The pink lifted for dark surfaces; #F45866 is 4.25:1 on the card surface. Never text on accentBg, which carries its own onAccentBg."},
        "accentBg": {"value": "#FFE3D1", "$note": "The same peach as light: a peach box on Prussian is the legible version of a store or callout; a dark plum was 1.3:1 against the page."},
        "onAccentBg": {"value": "#0E1C36", "$contrastAgainst": ["accentBg"], "$minRatio": 7},
        "onAccentBgMuted": {"value": "#44506A", "$contrastAgainst": ["accentBg"], "$minRatio": 4.5},
        "success": {"value": "#7ED49A", "$contrastAgainst": ["bg", "surface", "successBg"], "$minRatio": 4.5},
        "successBg": {"value": "#12301C"},
        "error": {"value": "#FFA3A3", "$contrastAgainst": ["bg", "surface", "errorBg"], "$minRatio": 4.5},
        "errorBg": {"value": "#3A1414"},
        "focus": {"value": "#D7F9FF", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 3, "$note": "Palette: light cyan."},
        "codeBg": {"value": "#1E3260"},
        "codeText": {"value": "#F9FBF2", "$contrastAgainst": ["codeBg"], "$minRatio": 7},
        "brand1": {"value": "#FFEDE1"},
        "brand2": {"value": "#F9FBF2"},
        "brand3": {"value": "#D7F9FF"},
        "brand4": {"value": "#AFCBFF"},
        "brand5": {"value": "#0E1C36"},
        "brand6": {"value": "#F45866"}
      }
    },
    "highContrast": {
      "$description": "Black on white, one accent, thicker borders. Windows forced-colors users get system colors instead, via CSS in base.css.",
      "color": {
        "bg":            { "value": "#FFFFFF" },
        "bgSubtle":      { "value": "#FFFFFF" },
        "surface":       { "value": "#FFFFFF" },
        "text":          { "value": "#000000", "$contrastAgainst": ["bg", "surface"], "$minRatio": 7 },
        "textMuted":     { "value": "#000000", "$contrastAgainst": ["bg", "surface"], "$minRatio": 7 },
        "border":        { "value": "#000000", "$contrastAgainst": ["bg", "surface"], "$minRatio": 3 },
        "borderSubtle":  { "value": "#000000" },
        "primary":       { "value": "#0000CC", "$contrastAgainst": ["bg", "surface"], "$minRatio": 7 },
        "onPrimary":     { "value": "#FFFFFF", "$contrastAgainst": ["primary"], "$minRatio": 7 },
        "primaryHover":  { "value": "#000080", "$contrastAgainst": ["bg", "surface"], "$minRatio": 7 },
        "accent":        { "value": "#000000", "$contrastAgainst": ["bg", "surface", "accentBg"], "$minRatio": 7 },
        "accentBg":      { "value": "#FFFFFF" },
        "onAccentBg":    { "value": "#000000", "$contrastAgainst": ["accentBg"], "$minRatio": 7 },
        "onAccentBgMuted": { "value": "#000000", "$contrastAgainst": ["accentBg"], "$minRatio": 7 },
        "success":       { "value": "#005A00", "$contrastAgainst": ["bg", "surface", "successBg"], "$minRatio": 7 },
        "successBg":     { "value": "#FFFFFF" },
        "error":         { "value": "#B00000", "$contrastAgainst": ["bg", "surface", "errorBg"], "$minRatio": 7 },
        "errorBg":       { "value": "#FFFFFF" },
        "focus":         { "value": "#000000", "$contrastAgainst": ["bg", "surface"], "$minRatio": 3 },
        "codeBg":        { "value": "#FFFFFF" },
        "codeText":      { "value": "#000000", "$contrastAgainst": ["codeBg"], "$minRatio": 7 },
        "brand1":        { "value": "#000000" },
        "brand2":        { "value": "#000000" },
        "brand3":        { "value": "#000000" },
        "brand4":        { "value": "#000000" },
        "brand5":        { "value": "#000000" },
        "brand6":        { "value": "#000000" }
      }
    }
  }
}
