{
  "$description": "Design tokens for meredithb104.github.io. Source of truth. `npm run tokens` compiles this to src/styles/tokens.css. Every color that declares $contrastAgainst is checked with the WCAG 2.x formula by scripts/build-tokens.ts; the build fails if any pair drops below its $minRatio.",

  "font": {
    "family": {
      "sans": { "value": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" },
      "mono": { "value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" }
    },
    "size": {
      "sm": { "value": "0.875rem" },
      "md": { "value": "1rem" },
      "lg": { "value": "1.125rem" },
      "xl": { "value": "1.375rem" },
      "2xl": { "value": "clamp(1.5rem, 1.2rem + 1.2vw, 1.875rem)" },
      "3xl": { "value": "clamp(1.875rem, 1.3rem + 2.4vw, 2.75rem)" }
    },
    "lineHeight": {
      "tight": { "value": "1.2" },
      "body": { "value": "1.6" }
    },
    "weight": {
      "regular": { "value": "400" },
      "medium": { "value": "500" },
      "bold": { "value": "700" }
    }
  },

  "space": {
    "1": { "value": "0.25rem" },
    "2": { "value": "0.5rem" },
    "3": { "value": "0.75rem" },
    "4": { "value": "1rem" },
    "5": { "value": "1.5rem" },
    "6": { "value": "2rem" },
    "7": { "value": "3rem" },
    "8": { "value": "4.5rem" }
  },

  "radius": {
    "sm": { "value": "4px" },
    "md": { "value": "8px" },
    "lg": { "value": "14px" },
    "pill": { "value": "999px" }
  },

  "size": {
    "target": { "value": "44px", "$note": "WCAG 2.5.8 Target Size (Minimum) is 24px; 44px meets 2.5.5 (Enhanced)." },
    "focusRing": { "value": "3px" },
    "focusOffset": { "value": "2px" },
    "border": { "value": "1px" },
    "borderStrong": { "value": "2px" },
    "measure": { "value": "68ch", "$note": "WCAG 1.4.8 line length: no more than 80 characters." },
    "content": { "value": "72rem" }
  },

  "motion": {
    "duration": {
      "fast": { "value": "120ms" },
      "base": { "value": "200ms" }
    },
    "easing": {
      "standard": { "value": "cubic-bezier(0.2, 0, 0, 1)" }
    }
  },

  "theme": {
    "light": {
      "$description": "Near-white paper and ink with a coral signature. The five brand stops are the header band, card rules, and the monogram; none is ever text, so none declares a contrast target.",
      "color": {
        "bg":            { "value": "#FFFBF8" },
        "bgSubtle":      { "value": "#FDF1EA" },
        "surface":       { "value": "#FFFFFF" },
        "text":          { "value": "#2B1D1A", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 7 },
        "textMuted":     { "value": "#6B4B43", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 4.5 },
        "border":        { "value": "#A9776A", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 3 },
        "borderSubtle":  { "value": "#F4CDBD" },
        "primary":       { "value": "#2B1D1A", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 4.5, "$note": "Ink. Links are underlined and buttons are ink-filled, so the brand coral never has to carry text." },
        "onPrimary":     { "value": "#FFFFFF", "$contrastAgainst": ["primary"], "$minRatio": 4.5 },
        "primaryHover":  { "value": "#5A3A33", "$contrastAgainst": ["bg", "surface"], "$minRatio": 4.5 },
        "accent":        { "value": "#8F3328", "$contrastAgainst": ["bg", "surface", "bgSubtle", "accentBg"], "$minRatio": 4.5 },
        "accentBg":      { "value": "#FBC4AB" },
        "success":       { "value": "#1E6B3A", "$contrastAgainst": ["bg", "surface", "successBg"], "$minRatio": 4.5 },
        "successBg":     { "value": "#E3F1E6" },
        "error":         { "value": "#8B1A3C", "$contrastAgainst": ["bg", "surface", "errorBg"], "$minRatio": 4.5, "$note": "A berry, deliberately cooler than the coral primary so errors never read as brand color. Every error state also carries an icon and a word." },
        "errorBg":       { "value": "#FBE3EA" },
        "focus":         { "value": "#A8362E", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 3, "$note": "WCAG 2.4.13 / 1.4.11: the ring is offset 2px from the control, so its adjacent color is the page background. Deep coral: the one place the brand touches interaction, and only outside the control." },
        "codeBg":        { "value": "#FBEDE4" },
        "codeText":      { "value": "#2B1D1A", "$contrastAgainst": ["codeBg"], "$minRatio": 7 },
        "brand1":        { "value": "#F08080", "$note": "Coolors palette, stop 1 (light coral). Surface or accent only; 2.59:1 on white, never text." },
        "brand2":        { "value": "#F4978E" },
        "brand3":        { "value": "#F8AD9D" },
        "brand4":        { "value": "#FBC4AB" },
        "brand5":        { "value": "#FFDAB9" }
      }
    },
    "dark": {
      "$description": "Espresso and peach: the same family in the dark. Peach carries links and buttons with ink text on them.",
      "color": {
        "bg":            { "value": "#1E1512" },
        "bgSubtle":      { "value": "#2A1D19" },
        "surface":       { "value": "#2F211D" },
        "text":          { "value": "#FBEDE4", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 7 },
        "textMuted":     { "value": "#D6B8AB", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 4.5 },
        "border":        { "value": "#9C7A6D", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 3 },
        "borderSubtle":  { "value": "#4A3630" },
        "primary":       { "value": "#F8AD9D", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 4.5 },
        "onPrimary":     { "value": "#2B1D1A", "$contrastAgainst": ["primary"], "$minRatio": 4.5 },
        "primaryHover":  { "value": "#FBC4AB", "$contrastAgainst": ["bg", "surface"], "$minRatio": 4.5 },
        "accent":        { "value": "#FBC4AB", "$contrastAgainst": ["bg", "surface", "bgSubtle", "accentBg"], "$minRatio": 4.5 },
        "accentBg":      { "value": "#4A2A22" },
        "success":       { "value": "#7ED49A", "$contrastAgainst": ["bg", "surface", "successBg"], "$minRatio": 4.5 },
        "successBg":     { "value": "#12301C" },
        "error":         { "value": "#FFA3A3", "$contrastAgainst": ["bg", "surface", "errorBg"], "$minRatio": 4.5 },
        "errorBg":       { "value": "#3A1414" },
        "focus":         { "value": "#FFDAB9", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 3 },
        "codeBg":        { "value": "#3A2924" },
        "codeText":      { "value": "#FBEDE4", "$contrastAgainst": ["codeBg"], "$minRatio": 7 },
        "brand1":        { "value": "#F08080" },
        "brand2":        { "value": "#F4978E" },
        "brand3":        { "value": "#F8AD9D" },
        "brand4":        { "value": "#FBC4AB" },
        "brand5":        { "value": "#FFDAB9" }
      }
    },
    "highContrast": {
      "$description": "Black on white, one accent, thicker borders. Windows forced-colors users get system colors instead, via CSS in base.css.",
      "color": {
        "bg":            { "value": "#FFFFFF" },
        "bgSubtle":      { "value": "#FFFFFF" },
        "surface":       { "value": "#FFFFFF" },
        "text":          { "value": "#000000", "$contrastAgainst": ["bg", "surface"], "$minRatio": 7 },
        "textMuted":     { "value": "#000000", "$contrastAgainst": ["bg", "surface"], "$minRatio": 7 },
        "border":        { "value": "#000000", "$contrastAgainst": ["bg", "surface"], "$minRatio": 3 },
        "borderSubtle":  { "value": "#000000" },
        "primary":       { "value": "#0000CC", "$contrastAgainst": ["bg", "surface"], "$minRatio": 7 },
        "onPrimary":     { "value": "#FFFFFF", "$contrastAgainst": ["primary"], "$minRatio": 7 },
        "primaryHover":  { "value": "#000080", "$contrastAgainst": ["bg", "surface"], "$minRatio": 7 },
        "accent":        { "value": "#000000", "$contrastAgainst": ["bg", "surface", "accentBg"], "$minRatio": 7 },
        "accentBg":      { "value": "#FFFFFF" },
        "success":       { "value": "#005A00", "$contrastAgainst": ["bg", "surface", "successBg"], "$minRatio": 7 },
        "successBg":     { "value": "#FFFFFF" },
        "error":         { "value": "#B00000", "$contrastAgainst": ["bg", "surface", "errorBg"], "$minRatio": 7 },
        "errorBg":       { "value": "#FFFFFF" },
        "focus":         { "value": "#000000", "$contrastAgainst": ["bg", "surface"], "$minRatio": 3 },
        "codeBg":        { "value": "#FFFFFF" },
        "codeText":      { "value": "#000000", "$contrastAgainst": ["codeBg"], "$minRatio": 7 },
        "brand1":        { "value": "#000000" },
        "brand2":        { "value": "#000000" },
        "brand3":        { "value": "#000000" },
        "brand4":        { "value": "#000000" },
        "brand5":        { "value": "#000000" }
      }
    }
  }
}
