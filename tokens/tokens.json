{
  "$description": "Design tokens for meredithb104.github.io. Source of truth. `npm run tokens` compiles this to src/styles/tokens.css. Every color that declares $contrastAgainst is checked with the WCAG 2.x formula by scripts/build-tokens.ts; the build fails if any pair drops below its $minRatio.",

  "font": {
    "family": {
      "sans": { "value": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" },
      "mono": { "value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" }
    },
    "size": {
      "sm": { "value": "0.875rem" },
      "md": { "value": "1rem" },
      "lg": { "value": "1.125rem" },
      "xl": { "value": "1.375rem" },
      "2xl": { "value": "clamp(1.5rem, 1.2rem + 1.2vw, 1.875rem)" },
      "3xl": { "value": "clamp(1.875rem, 1.3rem + 2.4vw, 2.75rem)" }
    },
    "lineHeight": {
      "tight": { "value": "1.2" },
      "body": { "value": "1.6" }
    },
    "weight": {
      "regular": { "value": "400" },
      "medium": { "value": "500" },
      "bold": { "value": "700" }
    }
  },

  "space": {
    "1": { "value": "0.25rem" },
    "2": { "value": "0.5rem" },
    "3": { "value": "0.75rem" },
    "4": { "value": "1rem" },
    "5": { "value": "1.5rem" },
    "6": { "value": "2rem" },
    "7": { "value": "3rem" },
    "8": { "value": "4.5rem" }
  },

  "radius": {
    "sm": { "value": "4px" },
    "md": { "value": "8px" },
    "lg": { "value": "14px" },
    "pill": { "value": "999px" }
  },

  "size": {
    "target": { "value": "44px", "$note": "WCAG 2.5.8 Target Size (Minimum) is 24px; 44px meets 2.5.5 (Enhanced)." },
    "focusRing": { "value": "3px" },
    "focusOffset": { "value": "2px" },
    "border": { "value": "1px" },
    "borderStrong": { "value": "2px" },
    "measure": { "value": "68ch", "$note": "WCAG 1.4.8 line length: no more than 80 characters." },
    "content": { "value": "72rem" }
  },

  "motion": {
    "duration": {
      "fast": { "value": "120ms" },
      "base": { "value": "200ms" }
    },
    "easing": {
      "standard": { "value": "cubic-bezier(0.2, 0, 0, 1)" }
    }
  },

  "theme": {
    "light": {
      "color": {
        "bg":            { "value": "#FAF8F4" },
        "bgSubtle":      { "value": "#F1EDE6" },
        "surface":       { "value": "#FFFFFF" },
        "text":          { "value": "#1E1B18", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 7 },
        "textMuted":     { "value": "#5A554E", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 4.5 },
        "border":        { "value": "#8A8378", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 3 },
        "borderSubtle":  { "value": "#DDD6CB" },
        "primary":       { "value": "#1F4B7A", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 4.5 },
        "onPrimary":     { "value": "#FFFFFF", "$contrastAgainst": ["primary"], "$minRatio": 4.5 },
        "primaryHover":  { "value": "#163758", "$contrastAgainst": ["bg", "surface"], "$minRatio": 4.5 },
        "accent":        { "value": "#9A3F12", "$contrastAgainst": ["bg", "surface", "bgSubtle", "accentBg"], "$minRatio": 4.5 },
        "accentBg":      { "value": "#F7E7DC" },
        "success":       { "value": "#1E6B3A", "$contrastAgainst": ["bg", "surface", "successBg"], "$minRatio": 4.5 },
        "successBg":     { "value": "#E3F1E6" },
        "error":         { "value": "#A11D1D", "$contrastAgainst": ["bg", "surface", "errorBg"], "$minRatio": 4.5 },
        "errorBg":       { "value": "#F9E6E6" },
        "focus":         { "value": "#B54708", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 3, "$note": "WCAG 2.4.13 / 1.4.11: the ring is offset 2px from the control, so its adjacent color is the page background. It must reach 3:1 against each one." },
        "codeBg":        { "value": "#EFEAE2" },
        "codeText":      { "value": "#1E1B18", "$contrastAgainst": ["codeBg"], "$minRatio": 7 }
      }
    },
    "dark": {
      "color": {
        "bg":            { "value": "#0F1419" },
        "bgSubtle":      { "value": "#171E26" },
        "surface":       { "value": "#1B232C" },
        "text":          { "value": "#F1F4F7", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 7 },
        "textMuted":     { "value": "#B4BEC8", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 4.5 },
        "border":        { "value": "#8A96A3", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 3 },
        "borderSubtle":  { "value": "#2C3742" },
        "primary":       { "value": "#8CC4F5", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 4.5 },
        "onPrimary":     { "value": "#0B1E30", "$contrastAgainst": ["primary"], "$minRatio": 4.5 },
        "primaryHover":  { "value": "#A9D4F8", "$contrastAgainst": ["bg", "surface"], "$minRatio": 4.5 },
        "accent":        { "value": "#F2A26B", "$contrastAgainst": ["bg", "surface", "bgSubtle", "accentBg"], "$minRatio": 4.5 },
        "accentBg":      { "value": "#2E1B10" },
        "success":       { "value": "#7ED49A", "$contrastAgainst": ["bg", "surface", "successBg"], "$minRatio": 4.5 },
        "successBg":     { "value": "#12301C" },
        "error":         { "value": "#FFA3A3", "$contrastAgainst": ["bg", "surface", "errorBg"], "$minRatio": 4.5 },
        "errorBg":       { "value": "#3A1414" },
        "focus":         { "value": "#FFC66D", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 3 },
        "codeBg":        { "value": "#222B35" },
        "codeText":      { "value": "#F1F4F7", "$contrastAgainst": ["codeBg"], "$minRatio": 7 }
      }
    },
    "highContrast": {
      "$description": "Black on white, one accent, thicker borders. Windows forced-colors users get system colors instead, via CSS in base.css.",
      "color": {
        "bg":            { "value": "#FFFFFF" },
        "bgSubtle":      { "value": "#FFFFFF" },
        "surface":       { "value": "#FFFFFF" },
        "text":          { "value": "#000000", "$contrastAgainst": ["bg", "surface"], "$minRatio": 7 },
        "textMuted":     { "value": "#000000", "$contrastAgainst": ["bg", "surface"], "$minRatio": 7 },
        "border":        { "value": "#000000", "$contrastAgainst": ["bg", "surface"], "$minRatio": 3 },
        "borderSubtle":  { "value": "#000000" },
        "primary":       { "value": "#0000CC", "$contrastAgainst": ["bg", "surface"], "$minRatio": 7 },
        "onPrimary":     { "value": "#FFFFFF", "$contrastAgainst": ["primary"], "$minRatio": 7 },
        "primaryHover":  { "value": "#000080", "$contrastAgainst": ["bg", "surface"], "$minRatio": 7 },
        "accent":        { "value": "#000000", "$contrastAgainst": ["bg", "surface", "accentBg"], "$minRatio": 7 },
        "accentBg":      { "value": "#FFFFFF" },
        "success":       { "value": "#005A00", "$contrastAgainst": ["bg", "surface", "successBg"], "$minRatio": 7 },
        "successBg":     { "value": "#FFFFFF" },
        "error":         { "value": "#B00000", "$contrastAgainst": ["bg", "surface", "errorBg"], "$minRatio": 7 },
        "errorBg":       { "value": "#FFFFFF" },
        "focus":         { "value": "#000000", "$contrastAgainst": ["bg", "surface"], "$minRatio": 3 },
        "codeBg":        { "value": "#FFFFFF" },
        "codeText":      { "value": "#000000", "$contrastAgainst": ["codeBg"], "$minRatio": 7 }
      }
    }
  }
}
