{
  "$description": "Design tokens for meredithb104.github.io. Source of truth. `npm run tokens` compiles this to src/styles/tokens.css. Every color that declares $contrastAgainst is checked with the WCAG 2.x formula by scripts/build-tokens.ts; the build fails if any pair drops below its $minRatio.",

  "font": {
    "family": {
      "sans": { "value": "'Public Sans', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif", "$note": "Public Sans is self-hosted and preloaded; the system stack is the fallback and an option in the Lab." },
      "mono": { "value": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" }
    },
    "size": {
      "sm": { "value": "0.875rem" },
      "md": { "value": "1rem" },
      "lg": { "value": "1.125rem" },
      "xl": { "value": "1.375rem" },
      "2xl": { "value": "clamp(1.5rem, 1.2rem + 1.2vw, 1.875rem)" },
      "3xl": { "value": "clamp(1.875rem, 1.3rem + 2.4vw, 2.75rem)" }
    },
    "lineHeight": {
      "tight": { "value": "1.2" },
      "body": { "value": "1.6" }
    },
    "weight": {
      "regular": { "value": "400" },
      "medium": { "value": "500" },
      "bold": { "value": "700" }
    }
  },

  "space": {
    "1": { "value": "0.25rem" },
    "2": { "value": "0.5rem" },
    "3": { "value": "0.75rem" },
    "4": { "value": "1rem" },
    "5": { "value": "1.5rem" },
    "6": { "value": "2rem" },
    "7": { "value": "3rem" },
    "8": { "value": "4.5rem" }
  },

  "radius": {
    "sm": { "value": "4px" },
    "md": { "value": "8px" },
    "lg": { "value": "14px" },
    "pill": { "value": "999px" }
  },

  "size": {
    "target": { "value": "44px", "$note": "WCAG 2.5.8 Target Size (Minimum) is 24px; 44px meets 2.5.5 (Enhanced)." },
    "focusRing": { "value": "3px" },
    "focusOffset": { "value": "2px" },
    "border": { "value": "1px" },
    "borderStrong": { "value": "2px" },
    "measure": { "value": "68ch", "$note": "WCAG 1.4.8 line length: no more than 80 characters." },
    "content": { "value": "72rem" }
  },

  "motion": {
    "duration": {
      "fast": { "value": "120ms" },
      "base": { "value": "200ms" }
    },
    "easing": {
      "standard": { "value": "cubic-bezier(0.2, 0, 0, 1)" }
    }
  },

  "theme": {
    "light": {
      "color": {
        "bg": {"value": "#FBF7F0", "$note": "Warm cream, the ground the tangerine and caramel belong on."},
        "bgSubtle": {"value": "#EFF2E8", "$note": "A whisper of sage: header, code, subtle panels."},
        "surface": {"value": "#FFFFFF"},
        "text": {"value": "#231B1E", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 7, "$note": "Plum ink: the plum taken almost to black."},
        "textMuted": {"value": "#5C4F54", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 4.5},
        "border": {"value": "#8C7F84", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 3},
        "borderSubtle": {"value": "#DED5D8"},
        "primary": {"value": "#1F6F73", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 4.5, "$note": "Aqua #5AB0B5 deepened until it can be a link (the aqua itself is 2.4:1 on cream)."},
        "onPrimary": {"value": "#FFFFFF", "$contrastAgainst": ["primary"], "$minRatio": 4.5},
        "primaryHover": {"value": "#164F52", "$contrastAgainst": ["bg", "surface"], "$minRatio": 4.5},
        "accent": {"value": "#965800", "$contrastAgainst": ["bg", "surface", "bgSubtle", "accentBg"], "$minRatio": 4.5, "$note": "Tangerine #E38804 deepened until it can be text (the tangerine itself is 2.5:1 on cream); 4.6:1 on the blush tint."},
        "accentBg": {"value": "#F8E4E5", "$note": "Blush tint for callouts and diagram stores. Text on it uses onAccentBg."},
        "onAccentBg": {"value": "#231B1E", "$contrastAgainst": ["accentBg"], "$minRatio": 7},
        "onAccentBgMuted": {"value": "#5C4F54", "$contrastAgainst": ["accentBg"], "$minRatio": 4.5},
        "success": {"value": "#4E6A2E", "$contrastAgainst": ["bg", "surface", "successBg"], "$minRatio": 4.5, "$note": "Sage deepened."},
        "successBg": {"value": "#E6EDDC", "$note": "Sage tint."},
        "error": {"value": "#A64458", "$contrastAgainst": ["bg", "surface", "errorBg"], "$minRatio": 4.5, "$note": "The plum, as given: 5.5:1 on cream. Errors also carry an icon and the word."},
        "errorBg": {"value": "#F8E4E5"},
        "focus": {"value": "#B86F00", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 3, "$note": "Tangerine as a ring, deepened to clear 3:1 on cream; 2px outside every control."},
        "codeBg": {"value": "#EFF2E8"},
        "codeText": {"value": "#231B1E", "$contrastAgainst": ["codeBg"], "$minRatio": 7},
        "brand1": {"value": "#E38804", "$note": "Palette: tangerine. The monogram tile and the header rule."},
        "brand2": {"value": "#B4C89E", "$note": "Palette: sage. Surfaces and rules only."},
        "brand3": {"value": "#A64458", "$note": "Palette: plum."},
        "brand4": {"value": "#5AB0B5", "$note": "Palette: aqua. Side rules."},
        "brand5": {"value": "#C3851C", "$note": "Palette: caramel."},
        "brand6": {"value": "#E8A3A8", "$note": "Palette: blush. Surfaces only."}
      }
    },
    "dark": {
      "color": {
        "bg": {"value": "#231A1F", "$note": "Plum ink as the ground."},
        "bgSubtle": {"value": "#2A1F25"},
        "surface": {"value": "#332830"},
        "text": {"value": "#FBF7F0", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 7},
        "textMuted": {"value": "#D9CDD0", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 4.5},
        "border": {"value": "#8F8288", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 3},
        "borderSubtle": {"value": "#4A3C43"},
        "primary": {"value": "#5AB0B5", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 4.5, "$note": "Palette: aqua, as given."},
        "onPrimary": {"value": "#231A1F", "$contrastAgainst": ["primary"], "$minRatio": 4.5},
        "primaryHover": {"value": "#7FC7CB", "$contrastAgainst": ["bg", "surface"], "$minRatio": 4.5},
        "accent": {"value": "#E38804", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 4.5, "$note": "Palette: tangerine, as given. Never text on accentBg, which carries its own onAccentBg."},
        "accentBg": {"value": "#E8A3A8", "$note": "Palette: blush, as given, as a box on the plum ink; the same box is a blush tint on light."},
        "onAccentBg": {"value": "#231B1E", "$contrastAgainst": ["accentBg"], "$minRatio": 7},
        "onAccentBgMuted": {"value": "#4A3D42", "$contrastAgainst": ["accentBg"], "$minRatio": 4.5},
        "success": {"value": "#B4C89E", "$contrastAgainst": ["bg", "surface", "successBg"], "$minRatio": 4.5, "$note": "Palette: sage, as given. Also the border of the Pass pill."},
        "successBg": {"value": "#2E3A26"},
        "error": {"value": "#F2ADB2", "$contrastAgainst": ["bg", "surface", "errorBg"], "$minRatio": 4.5, "$note": "Blush lifted a step for text. Also the border of the Fail pill and of an invalid field."},
        "errorBg": {"value": "#5A2531"},
        "focus": {"value": "#E38804", "$contrastAgainst": ["bg", "surface", "bgSubtle"], "$minRatio": 3, "$note": "Tangerine as the ring."},
        "codeBg": {"value": "#3A2E35"},
        "codeText": {"value": "#FBF7F0", "$contrastAgainst": ["codeBg"], "$minRatio": 7},
        "brand1": {"value": "#E38804"},
        "brand2": {"value": "#B4C89E"},
        "brand3": {"value": "#A64458"},
        "brand4": {"value": "#5AB0B5"},
        "brand5": {"value": "#C3851C"},
        "brand6": {"value": "#E8A3A8"}
      }
    },
    "highContrast": {
      "$description": "Black on white, one accent, thicker borders. Windows forced-colors users get system colors instead, via CSS in base.css.",
      "color": {
        "bg":            { "value": "#FFFFFF" },
        "bgSubtle":      { "value": "#FFFFFF" },
        "surface":       { "value": "#FFFFFF" },
        "text":          { "value": "#000000", "$contrastAgainst": ["bg", "surface"], "$minRatio": 7 },
        "textMuted":     { "value": "#000000", "$contrastAgainst": ["bg", "surface"], "$minRatio": 7 },
        "border":        { "value": "#000000", "$contrastAgainst": ["bg", "surface"], "$minRatio": 3 },
        "borderSubtle":  { "value": "#000000" },
        "primary":       { "value": "#0000CC", "$contrastAgainst": ["bg", "surface"], "$minRatio": 7 },
        "onPrimary":     { "value": "#FFFFFF", "$contrastAgainst": ["primary"], "$minRatio": 7 },
        "primaryHover":  { "value": "#000080", "$contrastAgainst": ["bg", "surface"], "$minRatio": 7 },
        "accent":        { "value": "#000000", "$contrastAgainst": ["bg", "surface", "accentBg"], "$minRatio": 7 },
        "accentBg":      { "value": "#FFFFFF" },
        "onAccentBg":    { "value": "#000000", "$contrastAgainst": ["accentBg"], "$minRatio": 7 },
        "onAccentBgMuted": { "value": "#000000", "$contrastAgainst": ["accentBg"], "$minRatio": 7 },
        "success":       { "value": "#005A00", "$contrastAgainst": ["bg", "surface", "successBg"], "$minRatio": 7 },
        "successBg":     { "value": "#FFFFFF" },
        "error":         { "value": "#B00000", "$contrastAgainst": ["bg", "surface", "errorBg"], "$minRatio": 7 },
        "errorBg":       { "value": "#FFFFFF" },
        "focus":         { "value": "#000000", "$contrastAgainst": ["bg", "surface"], "$minRatio": 3 },
        "codeBg":        { "value": "#FFFFFF" },
        "codeText":      { "value": "#000000", "$contrastAgainst": ["codeBg"], "$minRatio": 7 },
        "brand1":        { "value": "#000000" },
        "brand2":        { "value": "#000000" },
        "brand3":        { "value": "#000000" },
        "brand4":        { "value": "#000000" },
        "brand5":        { "value": "#000000" },
        "brand6":        { "value": "#000000" }
      }
    }
  }
}
